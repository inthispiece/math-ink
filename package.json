{
  "name": "math-ink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:demo": "node scripts/dev.mjs --demo",
    "dev:ocr": "node scripts/dev.mjs --real",
    "dev:local": "node scripts/dev.mjs --local",
    "local:pull": "node scripts/local-qwen.mjs --pull",
    "local:serve": "node scripts/local-qwen.mjs --serve",
    "local:status": "node scripts/local-qwen.mjs --status",
    "eval:ai": "node scripts/eval-ai.mjs",
    "hosted:admin": "node scripts/hosted-admin.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "gateway": "node --env-file-if-exists=.env apps/gateway/src/server.ts",
    "preview": "node --env-file-if-exists=.env scripts/serve-preview.mjs",
    "package:preview": "node scripts/package-preview.mjs",
    "build": "pnpm build:web && node scripts/build-plugin.mjs",
    "build:web": "vite build apps/web --config vite.config.ts --outDir ../../dist/web --emptyOutDir && node scripts/finish-web.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=2 apps/gateway/test/*.test.ts apps/web/test/*.test.ts apps/host/test/*.test.ts tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:preview": "node --test tests/preview.production.test.mjs",
    "test:butterfly": "node --test tests/butterfly.production.test.mjs",
    "test:hosted": "node --test tests/hosted.production.test.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "doctor": "node scripts/doctor.mjs",
    "publish:github": "node scripts/publish-github.mjs"
  },
  "dependencies": { "katex": "0.16.22" },
  "devDependencies": {
    "@types/katex": "0.16.7",
    "@types/node": "24.7.2",
    "esbuild": "0.25.10",
    "fflate": "0.8.2",
    "siyuan": "1.1.3",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "@playwright/test": "1.56.0"
  }
}
