{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "noEmit": true, "allowImportingTsExtensions": true,
    "esModuleInterop": true, "skipLibCheck": true, "erasableSyntaxOnly": true, "types": ["node"]
  },
  "include": ["apps/**/*.ts", "tests/**/*.ts"],
  "exclude": ["upstream", "node_modules", "dist"]
}
