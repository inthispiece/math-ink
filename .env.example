# Copy to .env. This file contains no working credentials.
OCR_PROVIDER=deepseek
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
GATEWAY_PAIRING_TOKEN=
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=45000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:2b-instruct
OLLAMA_TIMEOUT_MS=180000
OCR_TIMEOUT_MS=20000
# Local development budgets; only real provider requests consume these.
# DeepSeek/Mathpix billing applies separately. Local Qwen and demos are unlimited.
OCR_INSTALLATION_DAILY_LIMIT=200
OCR_GLOBAL_DAILY_LIMIT=1000
OCR_GLOBAL_MONTHLY_LIMIT=10000
GATEWAY_TIME_ZONE=Asia/Shanghai
GATEWAY_DATABASE_PATH=.local/gateway.sqlite
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
