# Copy to .env. This file contains no working credentials.
OCR_PROVIDER=deepseek
GATEWAY_AUTH_MODE=local
# Trust only a private proxy that overwrites X-Forwarded-For; empty in local mode.
GATEWAY_TRUSTED_PROXY_IPS=
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
GATEWAY_PAIRING_TOKEN=
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=45000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:2b-instruct
OLLAMA_TIMEOUT_MS=180000
OCR_TIMEOUT_MS=20000
# Local development budgets; only real provider requests consume these.
# DeepSeek/Mathpix billing applies separately. Local Qwen and demos are unlimited.
OCR_INSTALLATION_DAILY_LIMIT=200
OCR_GLOBAL_DAILY_LIMIT=1000
OCR_GLOBAL_MONTHLY_LIMIT=10000
GATEWAY_TIME_ZONE=Asia/Shanghai
GATEWAY_DATABASE_PATH=.local/gateway.sqlite
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Hosted deployment requires an operator-reviewed dated CNY price configuration.
# Leave blank for local development: cost stays unknown and reservations remain.
AI_PRICE_CONFIG=
AI_REQUEST_RESERVE_CNY=0.5
AI_TASK_MAX_COST_CNY=5
AI_USER_DAILY_BUDGET_CNY=5
AI_USER_MONTHLY_BUDGET_CNY=50
AI_GLOBAL_DAILY_BUDGET_CNY=50
AI_GLOBAL_MONTHLY_BUDGET_CNY=500
AI_USER_CONCURRENCY=1
AI_GLOBAL_CONCURRENCY=4
AI_USER_REQUESTS_PER_MINUTE=10
AI_GLOBAL_REQUESTS_PER_MINUTE=60
OCR_USER_MONTHLY_LIMIT=200
AI_TASK_TIMEOUT_MS=120000
AI_TASK_MAX_OUTPUT_TOKENS=8192
AI_TASK_MAX_CONTEXT_BYTES=32000
AI_TASK_MAX_BLOCKS=80
